// gsc-mcp-ts on Cloudflare Workers — deployable template.
//
// Replace every value marked REPLACE_ME, then:
//   npx wrangler kv namespace create GSC_TOKENS        # paste the id below
//   npx wrangler secret put GOOGLE_CLIENT_ID
//   npx wrangler secret put GOOGLE_CLIENT_SECRET
//   openssl rand -base64 32 | npx wrangler secret put TOKEN_ENCRYPTION_KEY
//   npm run deploy
//   open https://<your host>/auth/google              # authorize Google once
//
// See README.md ("Deploy to Cloudflare Workers") for the Access setup.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gsc-mcp-ts",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  // No nodejs_compat needed: the Worker entry only uses web-standard APIs.

  // Only reachable through the custom domain (behind Cloudflare Access).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    // REPLACE_ME: a hostname on a zone in your Cloudflare account.
    { "pattern": "gsc-mcp.example.com", "custom_domain": true }
  ],

  // Encrypted Google refresh token written by /auth/google.
  "kv_namespaces": [
    // REPLACE_ME: id printed by `npx wrangler kv namespace create GSC_TOKENS`.
    { "binding": "GSC_TOKENS", "id": "REPLACE_ME_KV_NAMESPACE_ID" }
  ],

  // Authentication follows what is set: CF_ACCESS_TEAM_DOMAIN + CF_ACCESS_AUD enable the
  // Cloudflare Access check, the MCP_AUTH_TOKEN secret enables a bearer check; both set means both must pass.
  "vars": {
    // REPLACE_ME: same hostname as in "routes" (comma-separate several).
    "MCP_ALLOWED_HOSTS": "gsc-mcp.example.com",
    // REPLACE_ME: <team> is the team name shown under Zero Trust → Settings.
    "CF_ACCESS_TEAM_DOMAIN": "https://REPLACE_ME.cloudflareaccess.com",
    // REPLACE_ME: Access application → Overview → Application Audience (AUD) Tag.
    "CF_ACCESS_AUD": "REPLACE_ME_ACCESS_AUD_TAG",
    // Optional:
    // "TOOL_TIER": "read",  // read (default), write, or destructive; write and up: re-open /auth/google
    // "GSC_DATA_STATE": "all",
    // "GOOGLE_AUTH_ADMINS": "you@example.com",  // who may connect/disconnect Google
    // "GOOGLE_REDIRECT_URI": "https://gsc-mcp.example.com/auth/google/callback"
  }

  // Secrets (never put these in this file):
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET   Google OAuth client, type "Web application"
  //   TOKEN_ENCRYPTION_KEY                     base64 of 32 random bytes
  //   GOOGLE_REFRESH_TOKEN                     optional fallback when nothing is stored in KV
  //   MCP_AUTH_TOKEN                           optional bearer token (at least 32 bytes)
  //
  // Google Analytics 4 (ga4_* tools) needs no setting here: enable the Analytics Admin + Data APIs in the
  // GCP project, give the Google user Viewer on each GA4 property, then open /auth/google?ga4=1.
  // Optional search-engine secrets (tools appear only when the secret is set):
  //   BING_API_KEY                             Bing Webmaster Tools > Settings > API access > Generate API Key
  //                                            npx wrangler secret put BING_API_KEY
  //   INDEXNOW_KEY                             your IndexNow key; host it at https://<host>/<key>.txt
  //                                            npx wrangler secret put INDEXNOW_KEY
  //   (optional var INDEXNOW_KEY_LOCATION: key file URL, or a path such as /keys/indexnow.txt)
  //   (optional var INDEXNOW_HOSTS: hosts indexnow_check_key_file may fetch, e.g. "example.com,www.example.com")
  //   YANDEX_OAUTH_TOKEN                       oauth.yandex.com token (webmaster:hostinfo, webmaster:verify); expires in ~6 months
  //                                            npx wrangler secret put YANDEX_OAUTH_TOKEN
  //   SEZNAM_API_KEY                           per-site key from reporter.seznam.cz/wm > site > API, or JSON {"site":"key"}
  //                                            npx wrangler secret put SEZNAM_API_KEY
}
